#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D gPosition;
layout(set = 0, binding = 1) uniform sampler2D gNormal;
layout(set = 0, binding = 2) uniform sampler2D gAlbedo;
layout(set = 0, binding = 3) uniform sampler2D gDepth;

layout(set = 1, binding = 0) uniform QueryUBO {
    mat4 view;
    mat4 proj;
    mat4 viewInverse;
    mat4 projInverse;
    float maxDistance;
    float stepSize;
    int imageWidth;
    int imageHeight;
    vec2 apertureOffset;
    float handoffPlaneDistance;
    float sensorPlaneDistance;
    int accumSampleIndex;
    float testWavelengthNm;
    float goldenTestX;
    float goldenTestZ;
    float goldenTestDirX;
    float goldenTestDirY;
    float goldenTestDirZ;
    float goldenTestWavelength;
    int visualizeFold;
    float foldEpsilon;
} query;

struct GoldenTestResult {
    float x_o;
    float z_o;
    float dirx_o;
    float diry_o;
    float dirz_o;
    float intensity;
    float pad0;
    float pad1;
};

struct QueryResult {
    vec4 hitPosition;
    vec4 hitNormal;
    vec4 hitAlbedo;
    int hit;
    int pad0;
    int pad1;
    int pad2;
};

layout(set = 1, binding = 1) buffer QueryResultBuffer {
    QueryResult result;
};

layout(set = 1, binding = 2, rgba8) uniform image2D ssrOutputImage;

layout(set = 1, binding = 4, rgba32f) uniform image2D ssrAccumImage;

layout(set = 1, binding = 3) buffer GoldenTestResultBuffer {
    GoldenTestResult goldenResult;
};

layout(set = 2, binding = 0) readonly buffer LensWeights {
    float w[4448];
};

layout(set = 2, binding = 1) uniform LensNormUBO {
    float positionScaleI;
    float positionScaleO;
    float wavelengthMin;
    float wavelengthMax;
    float intensityMin;
    float intensityMax;
} lensNorm;

const int L0_OFFSET = 0;
const int L1_OFFSET = 160;
const int L2_OFFSET = 1184;
const int L3_OFFSET = 2208;
const int L4_OFFSET = 3232;
const int L5_OFFSET = 4256;

void linear32x5(int offset, float x[5], out float y[32])
{
    for (int i = 0; i < 32; i++) {
        float sum = 0.0;
        for (int j = 0; j < 5; j++) {
            sum += w[offset + i * 5 + j] * x[j];
        }
        y[i] = sum;
    }
}

void linear32x32(int offset, float x[32], out float y[32])
{
    for (int i = 0; i < 32; i++) {
        float sum = 0.0;
        for (int j = 0; j < 32; j++) {
            sum += w[offset + i * 32 + j] * x[j];
        }
        y[i] = sum;
    }
}

void linear6x32(int offset, float x[32], out float y[6])
{
    for (int i = 0; i < 6; i++) {
        float sum = 0.0;
        for (int j = 0; j < 32; j++) {
            sum += w[offset + i * 32 + j] * x[j];
        }
        y[i] = sum;
    }
}

void evalLensMLP(float input5[5], out float outp[6])
{
    float h1[32]; linear32x5(L0_OFFSET, input5, h1);
    for (int i = 0; i < 32; i++) h1[i] = tanh(h1[i]);

    float h2[32]; linear32x32(L1_OFFSET, h1, h2);
    for (int i = 0; i < 32; i++) h2[i] = tanh(h2[i]);

    float h3[32]; linear32x32(L2_OFFSET, h2, h3);
    for (int i = 0; i < 32; i++) h3[i] = tanh(h3[i]);

    float h4[32]; linear32x32(L3_OFFSET, h3, h4);
    for (int i = 0; i < 32; i++) h4[i] = tanh(h4[i]);

    float h5[32]; linear32x32(L4_OFFSET, h4, h5);
    for (int i = 0; i < 32; i++) h5[i] = tanh(h5[i]);

    linear6x32(L5_OFFSET, h5, outp);
}

void canonicalizeInput(float x_i, float z_i, float dirx_i, float diry_i, float dirz_i,
                        out float r, out float dirx_c, out float diry_c, out float dirz_c,
                        out float rotAngle, out bool wasMirrored)
{
    r = length(vec2(x_i, z_i));
    rotAngle = atan(x_i, z_i);

    float c = cos(rotAngle);
    float s = sin(rotAngle);
    float dirx_rot = dirx_i * c - dirz_i * s;
    float dirz_rot = dirx_i * s + dirz_i * c;

    wasMirrored = dirx_rot < 0.0;
    dirx_c = wasMirrored ? -dirx_rot : dirx_rot;
    dirz_c = dirz_rot;
    diry_c = diry_i;
}

void decanonicalizeOutput(float x_o_c, float z_o_c, float dirx_o_c, float diry_o_c, float dirz_o_c,
                           float rotAngle, bool wasMirrored,
                           out float x_o_w, out float z_o_w, out float dirx_o_w, out float diry_o_w, out float dirz_o_w)
{
    if (wasMirrored) {
        x_o_c = -x_o_c;
        dirx_o_c = -dirx_o_c;
    }

    float c = cos(-rotAngle);
    float s = sin(-rotAngle);
    x_o_w = x_o_c * c - z_o_c * s;
    z_o_w = x_o_c * s + z_o_c * c;
    dirx_o_w = dirx_o_c * c - dirz_o_c * s;
    dirz_o_w = dirx_o_c * s + dirz_o_c * c;
    diry_o_w = diry_o_c;
}

vec3 viewToLensLocal(vec3 v) { return vec3(v.x, -v.z, v.y); }
vec3 lensLocalToView(vec3 l) { return vec3(l.x, l.z, -l.y); }

void evalLensRay(vec3 originWorld, vec3 dirWorld, out vec3 exitOriginWorld, out vec3 exitDirWorld, out vec3 debugDirLensLocal,
                  out bool wasMirroredOut, out float dirxCOut)
{
    vec3 pinholeDirView = mat3(query.view) * dirWorld;
    vec3 pinholeDirLensLocal = viewToLensLocal(pinholeDirView);

    float t = -query.sensorPlaneDistance / pinholeDirLensLocal.y;
    vec3 p = t * pinholeDirLensLocal;

    vec3 a = vec3(query.apertureOffset.x, 0.0, query.apertureOffset.y);

    vec3 dirLensLocal = normalize(a - p);

    debugDirLensLocal = dirLensLocal;

    vec3 dirTrain = vec3(dirLensLocal.x, -dirLensLocal.y, dirLensLocal.z);

    float r, dirx_c, diry_c, dirz_c, rotAngle;
    bool wasMirrored;
    canonicalizeInput(a.x, a.z,
                       dirTrain.x, dirTrain.y, dirTrain.z,
                       r, dirx_c, diry_c, dirz_c, rotAngle, wasMirrored);
    wasMirroredOut = wasMirrored;
    dirxCOut = dirx_c;

    float wavelengthNorm = (query.testWavelengthNm - lensNorm.wavelengthMin) /
                           (lensNorm.wavelengthMax - lensNorm.wavelengthMin);

    float input5[5] = float[5](r / lensNorm.positionScaleI, dirx_c, diry_c, dirz_c, wavelengthNorm);
    float outp[6];
    evalLensMLP(input5, outp);

    float x_o = outp[0] * lensNorm.positionScaleO;
    float z_o = outp[1] * lensNorm.positionScaleO;

    float x_o_w, z_o_w, dirx_o_w, diry_o_w, dirz_o_w;
    decanonicalizeOutput(x_o, z_o, outp[2], outp[3], outp[4], rotAngle, wasMirrored,
                          x_o_w, z_o_w, dirx_o_w, diry_o_w, dirz_o_w);

    vec3 exitPosLensLocal = vec3(x_o_w, query.handoffPlaneDistance, z_o_w);
    vec3 exitDirLensLocal = normalize(vec3(dirx_o_w, -diry_o_w, dirz_o_w));

    vec3 exitPosView = lensLocalToView(exitPosLensLocal);
    vec3 exitDirView = lensLocalToView(exitDirLensLocal);

    exitOriginWorld = originWorld + mat3(query.viewInverse) * exitPosView;
    exitDirWorld = normalize(mat3(query.viewInverse) * exitDirView);
}

void evalLensDirect(float x_i, float z_i, float dirx_i, float diry_i, float dirz_i, float wavelengthNm,
                     out float x_o, out float z_o, out float dirx_o, out float diry_o, out float dirz_o, out float intensity)
{
    float r, dirx_c, diry_c, dirz_c, rotAngle;
    bool wasMirrored;
    canonicalizeInput(x_i, z_i, dirx_i, diry_i, dirz_i, r, dirx_c, diry_c, dirz_c, rotAngle, wasMirrored);

    float wavelengthNorm = (wavelengthNm - lensNorm.wavelengthMin) / (lensNorm.wavelengthMax - lensNorm.wavelengthMin);

    float input5[5] = float[5](r / lensNorm.positionScaleI, dirx_c, diry_c, dirz_c, wavelengthNorm);
    float outp[6];
    evalLensMLP(input5, outp);

    float x_o_c = outp[0] * lensNorm.positionScaleO;
    float z_o_c = outp[1] * lensNorm.positionScaleO;

    vec3 rawDir = normalize(vec3(outp[2], outp[3], outp[4]));

    decanonicalizeOutput(x_o_c, z_o_c, rawDir.x, rawDir.y, rawDir.z, rotAngle, wasMirrored,
                          x_o, z_o, dirx_o, diry_o, dirz_o);

    intensity = outp[5] * (lensNorm.intensityMax - lensNorm.intensityMin) + lensNorm.intensityMin;
}

bool marchRay(vec3 origin, vec3 dir, out vec3 hitPos, out vec3 hitNormal, out vec3 hitAlbedo)
{
    vec3 prevSamplePoint = origin;
    int steps = int(query.maxDistance / query.stepSize);

    for (int i = 1; i <= steps; i++) {
        vec3 samplePoint = origin + dir * (float(i) * query.stepSize);

        vec4 clip = query.proj * query.view * vec4(samplePoint, 1.0);
        if (clip.w <= 0.0) { prevSamplePoint = samplePoint; continue; }
        vec3 ndc = clip.xyz / clip.w;
        if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0) { prevSamplePoint = samplePoint; continue; }

        vec2 uv = ndc.xy * 0.5 + 0.5;
        float sceneDepthNdc = texture(gDepth, uv).r;

        if (sceneDepthNdc >= 0.99999) {
            prevSamplePoint = samplePoint;
            continue;
        }

        if (ndc.z >= sceneDepthNdc) {
            vec3 lo = prevSamplePoint;
            vec3 hi = samplePoint;
            for (int b = 0; b < 8; b++) {
                vec3 mid = (lo + hi) * 0.5;
                vec4 midClip = query.proj * query.view * vec4(mid, 1.0);
                vec3 midNdc = midClip.xyz / midClip.w;
                vec2 midUv = midNdc.xy * 0.5 + 0.5;
                float midSceneDepth = texture(gDepth, midUv).r;
                if (midNdc.z >= midSceneDepth) {
                    hi = mid;
                } else {
                    lo = mid;
                }
            }

            vec4 hiClip = query.proj * query.view * vec4(hi, 1.0);
            vec3 hiNdc = hiClip.xyz / hiClip.w;
            vec2 hiUv = hiNdc.xy * 0.5 + 0.5;

            hitPos = texture(gPosition, hiUv).xyz;
            hitNormal = texture(gNormal, hiUv).xyz;
            hitAlbedo = texture(gAlbedo, hiUv).xyz;
            return true;
        }

        prevSamplePoint = samplePoint;
    }

    return false;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= query.imageWidth || pixel.y >= query.imageHeight) return;

    vec2 pixelCenter = vec2(pixel) + vec2(0.5);
    vec2 uv = pixelCenter / vec2(query.imageWidth, query.imageHeight);
    vec2 d = uv * 2.0 - 1.0;

    vec4 originH = query.viewInverse * vec4(0, 0, 0, 1);
    vec4 targetH = query.projInverse * vec4(d.x, d.y, 1, 1);
    vec4 dirH = query.viewInverse * vec4(normalize(targetH.xyz), 0);

    vec3 lensOrigin, lensDir, debugUnused;
    bool wasMirrored;
    float dirxC;
    evalLensRay(originH.xyz, normalize(dirH.xyz), lensOrigin, lensDir, debugUnused, wasMirrored, dirxC);

    vec3 hitPos, hitNormal, hitAlbedo;
    bool didHit = marchRay(lensOrigin, lensDir, hitPos, hitNormal, hitAlbedo);

    vec3 outColor = vec3(0.0);
    if (didHit) {
        vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));
        float diffuse = max(dot(hitNormal, lightDir), 0.0);
        outColor = hitAlbedo * (diffuse + 0.15);
    }

    if (query.visualizeFold != 0) {
        // dirx_c is already folded non-negative; recover the pre-fold signed
        // value so pixels near the mirror boundary (dirxRot ~ 0) can be highlighted.
        float dirxRot = wasMirrored ? -dirxC : dirxC;
        vec3 hemisphereTint = wasMirrored ? vec3(0.6, 0.15, 0.15) : vec3(0.15, 0.15, 0.6);
        outColor = didHit ? mix(outColor, hemisphereTint, 0.5) : hemisphereTint * 0.5;

        float seamBand = 1.0 - smoothstep(0.0, max(query.foldEpsilon, 1e-5), abs(dirxRot));
        outColor = mix(outColor, vec3(1.0, 1.0, 0.0), seamBand);
    }

    imageStore(ssrOutputImage, pixel, vec4(outColor, 1.0));

    if(query.accumSampleIndex == 0) {
        imageStore(ssrAccumImage, pixel, vec4(outColor, 1.0));
    } else {
        vec4 prevAccum = imageLoad(ssrAccumImage, pixel);
        float weight = 1.0 / float(query.accumSampleIndex + 1);
        imageStore(ssrAccumImage, pixel, mix(prevAccum, vec4(outColor, 1.0), weight));
    }

    if (pixel == ivec2(0, 0)) {
        vec4 fwdOriginH = query.viewInverse * vec4(0, 0, 0, 1);
        vec4 fwdDirH = query.viewInverse * vec4(0, 0, -1, 0);

        vec3 fwdLensOrigin, fwdLensDir, fwdDebugDirLensLocal;
        bool fwdWasMirrored;
        float fwdDirxC;
        evalLensRay(fwdOriginH.xyz, normalize(fwdDirH.xyz), fwdLensOrigin, fwdLensDir, fwdDebugDirLensLocal, fwdWasMirrored, fwdDirxC);

        goldenResult.pad0 = fwdDebugDirLensLocal.x; // TEMP DEBUG -- ~0 only when apertureOffset=(0,0); nonzero is expected once aperture offset is nonzero
        goldenResult.pad1 = fwdDebugDirLensLocal.z; // TEMP DEBUG -- ~0 only when apertureOffset=(0,0); nonzero is expected once aperture offset is nonzero

        vec3 fwdHitPos, fwdHitNormal, fwdHitAlbedo;
        bool fwdHit = marchRay(fwdLensOrigin, fwdLensDir, fwdHitPos, fwdHitNormal, fwdHitAlbedo);

        if (fwdHit) {
            result.hitPosition = vec4(fwdHitPos, 1.0);
            result.hitNormal = vec4(fwdHitNormal, 0.0);
            result.hitAlbedo = vec4(fwdHitAlbedo, 1.0);
            result.hit = 1;
        } else {
            result.hit = 0;
        }

        float g_xo, g_zo, g_dirxo, g_diryo, g_dirzo, g_intensity;
        evalLensDirect(query.goldenTestX, query.goldenTestZ,
                        query.goldenTestDirX, query.goldenTestDirY, query.goldenTestDirZ,
                        query.goldenTestWavelength,
                        g_xo, g_zo, g_dirxo, g_diryo, g_dirzo, g_intensity);

        goldenResult.x_o = g_xo;
        goldenResult.z_o = g_zo;
        goldenResult.dirx_o = g_dirxo;
        goldenResult.diry_o = g_diryo;
        goldenResult.dirz_o = g_dirzo;
        goldenResult.intensity = g_intensity;
    }
}
